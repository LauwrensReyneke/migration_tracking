# =============================================
# Migration Tracking Environment Variable Guide
# =============================================
# Copy this file to .env (local dev) and fill values as needed.
# NOTE: Vercel production uses Project Settings > Environment Variables.
# Redeploy after changing any VITE_ value (they are statically injected at build time).

# Seed SQL auto-import (optional). Must exist in public/ directory.
# Example: VITE_SEED_SQL=/seed.sql
VITE_SEED_SQL=

# Public blob URL for remote DB load (leave blank to load via /api/db which proxies the blob).
VITE_SQLITE_URL=

# Enable client-side verbose DB logs (set to 1 for debug).
VITE_DEBUG_DB=
# Enable client-side env boot log (set to 1 to log redacted envs in console).
VITE_DEBUG_ENV=

# Server-side (set in Vercel, NO VITE_ prefix):
# BLOB_READ_WRITE_TOKEN=auto-generated by Vercel Blob; required for PUT on /api/db
# Optional: DEBUG_VERBOSE_DB=1 (adds extra logs)

# Dry-run test (no blob write):
# curl -X PUT "$DEPLOY_URL/api/db?dry=1&debug=1" -H "Content-Type: application/octet-stream" --data-binary @data/mt.sqlite

# After deploying:
# 1. Visit the app and open the EnvDebug panel (/?env=1 if wired) to run a dry-run PUT.
# 2. Perform a write (e.g., add a project) and check console for [pushRemoteDB] logs.

# Optional protection for /api/db (soft barrier; still exposes full DB to any client with the key)
# Set DB_API_KEY (server-side only) and DB_REQUIRE_KEY=1 to enforce x-api-key header.
# Optionally restrict browser Origin header: comma-separated list of allowed origins.
# Example: DB_ALLOWED_ORIGINS=https://yourapp.vercel.app,https://staging-yourapp.vercel.app
# Client pass-through (NOT secure if exposed to public users) for convenience:
# VITE_DB_API_KEY= (only set if you intentionally want the front-end to send the key)
DB_API_KEY=
DB_REQUIRE_KEY=1
DB_ALLOWED_ORIGINS=
VITE_DB_API_KEY=
