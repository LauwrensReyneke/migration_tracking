# =============================================
# Migration Tracking Environment Variable Guide
# =============================================
# Copy this file to .env (local dev) and fill values as needed.
# NOTE: Vercel production uses Project Settings > Environment Variables.
# Redeploy after changing any VITE_ value (they are statically injected at build time).

# Seed SQL auto-import (optional). Must exist in public/ directory.
# Example: VITE_SEED_SQL=/seed.sql
VITE_SEED_SQL=

# Public blob URL for remote DB load (leave blank for empty/new DB until first upload).
# After first successful write, GET /api/db/update (debug=1) returns the blob URL.
VITE_SQLITE_URL=

# Client write token (only set if you want the browser to push DB changes directly).
# Should match server DB_WRITE_TOKEN exactly. Leave blank to disable client writes.
VITE_DB_WRITE_TOKEN=

# Optional legacy alternative token (not recommended). Prefer single token above.
VITE_BLOB_READ_WRITE_TOKEN=

# Enable client-side verbose DB push logging (set to 1 for debug).
VITE_DEBUG_DB=
# Enable client-side env boot log (set to 1 to log redacted envs in console).
VITE_DEBUG_ENV=

# Server-side (DO NOT prefix with VITE_): set in Vercel, not in client .env
# DB_WRITE_TOKEN=your-secret-token-here
# BLOB_READ_WRITE_TOKEN=optional-secondary-token
# DEBUG_VERBOSE_DB_UPDATE=1 (optional: verbose server logs)

# Dry-run test (no blob write) example:
# curl -X PUT "$DEPLOY_URL/api/db/update?dry=1&debug=1" -H "Authorization: Bearer $DB_WRITE_TOKEN" -H "Content-Type: application/octet-stream" --data-binary @data/mt.sqlite

# After updating tokens:
# 1. Redeploy (client bundle must include VITE_DB_WRITE_TOKEN if used).
# 2. Visit /?env=1 to view EnvDebug panel for redacted token presence.
# 3. Trigger a write action; inspect console logs for pushRemoteDB details.
