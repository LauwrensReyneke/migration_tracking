# Optional: path to an initial SQL snapshot to auto-import when the DB is empty
# Put your .sql file in the public/ directory, then point to it here
# Example:
# VITE_SEED_SQL=/migration_tracking_2025-11-04_11-32-01.sql
VITE_SEED_SQL=

# Frontend DB endpoints (default to serverless API)
VITE_SQLITE_URL=/api/db
VITE_SQLITE_PUT_URL=/api/db
VITE_SQLITE_PUT_METHOD=PUT
# If you set a write token on the server (DB_WRITE_TOKEN), mirror it here for client writes
# VITE_DB_WRITE_TOKEN=
